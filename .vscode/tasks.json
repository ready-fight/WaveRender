{
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Configure WaveRender Debug",
        "type": "shell",
        "command": "cmake",
        "args": [
          "--preset",
          "windows-msvc-debug"
        ],
        "problemMatcher": []
      },
      {
        "label": "Build WaveRender Debug",
        "type": "shell",
        "command": "cmake",
        "args": [
          "--build",
          "--preset",
          "debug"
        ],
        "dependsOn": "Configure WaveRender Debug",
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "problemMatcher": "$msCompile"
      }
    ]
  }